{# Renders one Block (BodyParagraph | BulletList | TableBlock | ImageRef | Heading) #}
{% set kind = block.__class__.__name__ %}
{% if kind == "Heading" %}
  <h3 class="subhead">{{ block.text }}</h3>
{% elif kind == "BodyParagraph" %}
  <p class="body">{{ block.html | safe }}</p>
{% elif kind == "BulletList" %}
  {# Render bullets via a 2-cell table with the marker as a real glyph
     in the cell — pseudo-elements (::before) don't survive Gmail/Outlook. #}
  <table class="bullets" role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:4px 0 12px 0;border-collapse:collapse;">
    {% for item in block.items %}
    <tr>
      <td valign="top" width="22" style="width:22px;padding:0 0 6px 0;color:#A8864B;font-size:12px;line-height:1.5;font-family:Calibri,'Segoe UI',Arial,sans-serif;">&#9632;</td>
      <td valign="top" style="padding:0 0 6px 0;color:#1C1C1E;font-size:14px;line-height:1.5;font-family:Calibri,'Segoe UI',Arial,sans-serif;">{{ item | safe }}</td>
    </tr>
    {% endfor %}
  </table>
{% elif kind == "TableBlock" %}
  {% if block.has_header %}
  <table class="data" role="presentation" cellpadding="0" cellspacing="0">
    <thead><tr bgcolor="#8B1A1F">
      {% for cell in block.rows[0] %}<th bgcolor="#8B1A1F">{{ cell | safe }}</th>{% endfor %}
    </tr></thead>
    <tbody>
      {% for row in block.rows[1:] %}
      <tr>
        {% for cell in row %}<td>{{ cell | safe }}</td>{% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <table class="layout" role="presentation" cellpadding="0" cellspacing="0">
    <tbody>
      {% for row in block.rows %}
      <tr>
        {% for cell in row %}<td>{{ cell | safe }}</td>{% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
{% elif kind == "ImageRef" %}
  {% if block.url %}
  <img class="inline" src="{{ block.url }}" alt="{{ block.alt or '' }}" />
  {% endif %}
{% endif %}

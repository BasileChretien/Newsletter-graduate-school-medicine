{# Renders one Block (BodyParagraph | BulletList | TableBlock | ImageRef | Heading) #}
{# Alignment (justified / centred / right) comes from the Word paragraph.
   `align_at` only ever returns an allowlisted value, or "" for the
   default -- which emits nothing, so unaligned documents are unchanged. #}
{% set kind = block.__class__.__name__ %}
{% if kind == "Heading" %}
  <h3 class="subhead">{{ block.text }}</h3>
{% elif kind == "BodyParagraph" %}
  {% set align = block.align | align_at %}
  <p class="body"{% if align %} style="text-align:{{ align }};"{% endif %}>{{ block.html | safe }}</p>
{% elif kind == "BulletList" %}
  {# Render bullets via a 2-cell table with the marker as a real glyph
     in the cell — pseudo-elements (::before) don't survive Gmail/Outlook. #}
  <table class="bullets" role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:4px 0 12px 0;border-collapse:collapse;">
    {% for item in block.items %}
    {% set align = block.aligns | align_at(loop.index0) %}
    <tr>
      <td valign="top" width="22" style="width:22px;min-width:22px;padding:0 0 6px 0;color:#A8864B;font-size:14px;line-height:1.5;font-family:Calibri,'Segoe UI',Arial,sans-serif;">&#9642;</td>
      <td valign="top" style="padding:0 0 6px 0;color:#1C1C1E;font-size:14px;line-height:1.5;font-family:Calibri,'Segoe UI',Arial,sans-serif;{% if align %}text-align:{{ align }};{% endif %}">{{ item | safe }}</td>
    </tr>
    {% endfor %}
  </table>
{% elif kind == "TableBlock" %}
  {% if block.has_header %}
  <table class="data" role="presentation" cellpadding="0" cellspacing="0">
    <thead><tr bgcolor="#003F88">
      {% for cell in block.rows[0] %}{% set align = block.aligns | align_at(0, loop.index0) %}<th bgcolor="#003F88"{% if align %} style="text-align:{{ align }};"{% endif %}>{{ cell | safe }}</th>{% endfor %}
    </tr></thead>
    <tbody>
      {% for row in block.rows[1:] %}
      {% set r = loop.index %}
      <tr>
        {% for cell in row %}{% set align = block.aligns | align_at(r, loop.index0) %}<td{% if align %} style="text-align:{{ align }};"{% endif %}>{{ cell | safe }}</td>{% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% elif block is highlights_block %}
  {# Featured Highlights: 3-col table with empty middle cells -> render
     as proper cards with a gold top rule and cream background. #}
  <table class="highlights" role="presentation" cellpadding="0" cellspacing="0" width="100%">
    <tbody>
      {% for row in block.rows %}
      {% set r = loop.index0 %}
      <tr>
        {% set align = block.aligns | align_at(r, 0) %}
        <td class="card" bgcolor="#EEF2F7" width="236" style="width:236px;{% if align %}text-align:{{ align }};{% endif %}">{{ row[0] | safe }}</td>
        {# Round-10 Visual M2: zero-width-space + mso-line-height-rule
           on the gutter cell, matching the divider treatment from
           bundle 28. `&nbsp;` was rendered with cell font metrics in
           Outlook 2016/2019 even with `font-size:0`, occasionally
           producing a 1-2px height bump in the gutter row. #}
        <td class="gutter" width="16" style="width:16px;font-size:0;line-height:0;mso-line-height-rule:exactly;">&#8203;</td>
        {% set align = block.aligns | align_at(r, 2) %}
        <td class="card" bgcolor="#EEF2F7" width="236" style="width:236px;{% if align %}text-align:{{ align }};{% endif %}">{{ row[2] | safe }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <table class="layout" role="presentation" cellpadding="0" cellspacing="0">
    <tbody>
      {% for row in block.rows %}
      {% set r = loop.index0 %}
      <tr>
        {% for cell in row %}{% set align = block.aligns | align_at(r, loop.index0) %}<td{% if align %} style="text-align:{{ align }};"{% endif %}>{{ cell | safe }}</td>{% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
{% elif kind == "ImageRef" %}
  {% if block.url %}
  <img class="inline" src="{{ block.url }}" alt="{{ block.alt or '' }}" />
  {% endif %}
{% endif %}

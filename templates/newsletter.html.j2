<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
<title>{{ masthead.title }} — Newsletter</title>
<!--[if mso]>
<style type="text/css">
.fallback-font { font-family: Arial, sans-serif !important; }
</style>
<![endif]-->
</head>
<body>
<center role="article" aria-roledescription="email" lang="en" style="width:100%;background-color:#E6EBF2;">
<!-- Preheader (hidden) -- a short teaser visible in the inbox-list
     preview before the editor opens the email. NEVER include the
     placeholder issue-line tokens (VOL. XX | ISSUE NO. XX | MONTH YEAR);
     a leak there reads as "broken send" in recipients' inboxes. -->
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#E6EBF2;">{{ masthead.tagline or "Newsletter of the Graduate School of Medicine, Nagoya University." }}</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#E6EBF2;">
<tr><td align="center" style="padding:24px 12px;">
<!--[if mso]>
<table role="presentation" align="center" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td>
<![endif]-->
<table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" align="center" bgcolor="#FFFFFF" style="width:600px;max-width:600px;background-color:#FFFFFF;">

<!-- MASTHEAD -->
<tr><td class="masthead" bgcolor="#EEF2F7">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      {% if logo_url %}
      <td class="masthead-logo" width="84" style="width:84px;vertical-align:middle;padding-right:16px;">
        {# Nest the seal in a 1-cell hairline-frame table.
           Outlook desktop renders padding on <img> with the parent
           bgcolor, producing a #EEF2F7 halo around the white seal --
           putting the white bgcolor + padding on the wrapping <td>
           keeps the inset frame consistent across Outlook, Gmail,
           and Apple Mail.

           The wrapping <table> declares an explicit `width="80"`
           (72px seal + 4px padding on each side) so MSO doesn't
           balloon it past the seal -- a child table without an
           explicit width can stretch and turn the hairline into
           a visible vertical bar. We also use `border-collapse`
           explicitly to suppress MSO's 2px double-border artifact.

           NOTE: do NOT add `font-size:0;line-height:0` to the
           wrapping <td> -- it collapses the alt-text fallback
           when Outlook desktop blocks images by default, leaving
           recipients with a blank box until they click "Download
           pictures." `display:block` on the <img> already kills
           the descender gap that the anti-gap trick guards against. #}
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="80" bgcolor="#FFFFFF" style="width:80px;background-color:#FFFFFF;border-collapse:collapse;">
          <tr><td bgcolor="#FFFFFF" style="background-color:#FFFFFF;padding:4px;border:1px solid #C9D2DE;">
            <img src="{{ logo_url }}" alt="Nagoya University Graduate School of Medicine" width="72" height="72" style="display:block;width:72px;height:72px;" />
          </td></tr>
        </table>
      </td>
      {% endif %}
      <td class="masthead-text" style="vertical-align:middle;">
        <p class="title">{{ masthead.title }}</p>
        {% if masthead.tagline %}<p class="tagline">{{ masthead.tagline }}</p>{% endif %}
        {% if masthead.subtitle %}<p class="subtitle">{{ masthead.subtitle }}</p>{% endif %}
        {% if masthead.issue_line %}<p class="issue">{{ masthead.issue_line | issue_line | safe }}</p>{% endif %}
      </td>
    </tr>
  </table>
</td></tr>

<!-- SECTIONS -->
{% for section in sections %}
<tr><td class="section">
  <h2 class="section-heading">
    <span class="num">{{ "%02d" | format(section.number) }}</span>
    <span class="sep">&nbsp;—&nbsp;</span>
    <span class="label">{{ section.title }}</span>
  </h2>
  {% for block in section.blocks %}
    {% include "partials/_block.html.j2" %}
  {% endfor %}
</td></tr>
{% if not loop.last %}
{# Round 8 Visual L1 + round 9 Email M2: Outlook desktop ignores
   `margin` on a <td>, so the gold rule used to extend full-width
   instead of aligning with the section's 28px L/R padding. A 3-cell
   layout (28px spacer + 1px-tall rule + 28px spacer) gives the same
   inset in every client.

   Outlook 2016/2019's Word renderer also expands empty cells to the
   font's line-height rather than the declared `height` -- so we add
   `mso-line-height-rule:exactly` to force exactly 1px, and use a
   zero-width-space (`&#8203;`) instead of `&nbsp;` since `&nbsp;`
   is rendered with the cell's font metrics regardless of `font-size:0`.
   The HTML `height="1"` attribute is the belt to the CSS `height:1px`'s
   braces. #}
<tr><td>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td width="28" style="width:28px;font-size:0;line-height:0;mso-line-height-rule:exactly;">&#8203;</td>
      <td class="divider" height="1" bgcolor="#A8864B" style="background-color:#A8864B;height:1px;font-size:0;line-height:1px;mso-line-height-rule:exactly;">&#8203;</td>
      <td width="28" style="width:28px;font-size:0;line-height:0;mso-line-height-rule:exactly;">&#8203;</td>
    </tr>
  </table>
</td></tr>
{% endif %}
{% endfor %}

<!-- FOOTER -->
<tr><td class="footer" bgcolor="#1C1C1E">
  {% if logo_url %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 10px 0;">
    <tr><td align="center" style="text-align:center;">
      <img src="{{ logo_url }}" alt="" width="60" height="60" style="display:block;width:60px;height:60px;border:0;margin:0 auto;" />
    </td></tr>
  </table>
  {% endif %}
  <p style="margin:0 0 6px 0;" class="institution">Graduate School of Medicine · Nagoya University</p>
  <p style="margin:0 0 6px 0;">
    <a href="https://www.med.nagoya-u.ac.jp/">med.nagoya-u.ac.jp</a>
  </p>
  <p style="margin:6px 0 0 0;font-size:10px;color:#6B6B70;">
    This newsletter is published by the Graduate School of Medicine, Nagoya University.
    If you would prefer not to receive future issues, please reply to this email and we will remove you from the list.
  </p>
</td></tr>

</table>
<!--[if mso]>
</td></tr></table>
<![endif]-->
</td></tr>
</table>
</center>
</body>
</html>

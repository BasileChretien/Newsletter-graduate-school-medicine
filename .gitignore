# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Build artifacts
dist/
*.tmp.docx
~$*

# Editor drop zone (commit only the .gitkeep)
drop-images/*
!drop-images/.gitkeep

# Personal recipient list -- never commit
recipients.txt
issue-*.docx

# Per-machine first-run marker dropped by the launcher to suppress the
# "first run" welcome banner on subsequent runs. Per-clone state, never
# committed.
.meridian_first_run

# Per-issue published assets are PUBLIC and PERMANENT (raw URL +
# git history). Two safeguards:
#   1. Don't commit asset directories implicitly. The publish-images
#      command stages exactly the per-issue dir explicitly.
#   2. Editors can opt OUT entirely by setting MERIDIAN_NO_PUBLIC_ASSETS=1
#      before running the toolkit (future flag).
# (Allow .gitkeep so the assets/ directory itself is preserved.)
assets/issue-*/manifest.previous.json

# issue-0 is the conventional local sandbox / scratch directory used
# during development -- never commit its contents (test images,
# manifest with PII). The publisher refuses to commit issue <= 0
# anyway, but belt-and-braces.
assets/issue-0/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test
.pytest_cache/
.coverage
htmlcov/
